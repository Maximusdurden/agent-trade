# Alpaca Paper Trading Credentials
# Get these from your Alpaca dashboard (make sure you are on the "Paper Trading" view)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_PAPER=True

# LLM Configurations
# Supported providers: 'gemini', 'openrouter'
LLM_PROVIDER=gemini

# Gemini Configuration
# Get API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Supported models: gemini-3.5-flash (default), gemini-3.5-pro, gemini-2.5-flash (legacy)
GEMINI_MODEL=gemini-3.5-flash

# OpenRouter Configuration (alternative to Gemini)
# Get API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Configurations (Use when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_HEAVYWEIGHT=deepseek/deepseek-r1
MODEL_DAILY_DRIVER=qwen/qwen-2.5-coder-32b-instruct
MODEL_UTILITY=openrouter/free
ACTIVE_MODEL_TIER=daily_driver

# Jira Connection Details (For automatic JIRA issue logging and logging overrides)
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your_jira_email_here
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=TMCL

# GCS Configuration
# Path to service account key file (JSON)
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
# GCS bucket name
GCS_BUCKET_NAME=your-gcs-bucket-name

# Secure Dashboard Authentication Settings
# Set a strong password to lock down the dashboard. Leave empty to disable authentication.
DASHBOARD_PASSWORD=your_highly_secure_dashboard_password_here
SESSION_SALT=choose_some_random_salt_string_here

# Options Trading Configuration
# Kill-switch: set to true to enable options trading (long calls/puts only).
OPTIONS_ENABLED=false
# Default DTE window for option selection (days-to-expiry).
OPTIONS_DTE_MIN=30
OPTIONS_DTE_MAX=45
# Hard safety bounds on DTE (agent may override within these only).
OPTIONS_DTE_HARD_MIN=14
OPTIONS_DTE_HARD_MAX=90
# Max % of equity per option position (cost = ask * 100 * contracts).
OPTIONS_MAX_ALLOCATION_PCT=0.05
# Max option contracts per ticker.
OPTIONS_MAX_CONTRACTS_PER_TICKER=5
# Conviction threshold (0.0-1.0): >= threshold routes to option path (leverage).
OPTIONS_CONVICTION_THRESHOLD=0.7
# Auto-close option positions when DTE <= this value (avoid exercise/assignment).
OPTIONS_AUTO_CLOSE_DTE=3
# OTM% window for strike selection.
OPTIONS_OTM_PERCENT_MIN=0.01
OPTIONS_OTM_PERCENT_MAX=0.10


