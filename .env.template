# Alpaca Paper Trading Credentials
# Get these from your Alpaca dashboard (make sure you are on the "Paper Trading" view)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_PAPER=True

# LLM Configurations
# Default provider can be 'gemini'. Others can be added later.
LLM_PROVIDER=gemini
# The Gemini API Key. Get this from Google AI Studio.
GEMINI_API_KEY=your_gemini_api_key_here
# The exact model to use (e.g., gemini-2.5-flash or gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-flash
